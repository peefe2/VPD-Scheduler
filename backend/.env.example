# 이 파일을 복사해 같은 폴더에 .env 로 저장하고 값을 채운다. .env는 git에 올라가지 않는다.
# 키는 각자 Google AI Studio(https://aistudio.google.com)에서 무료로 받는다. 남에게 공유하지 않는다.

# Gemini API 키 — 비워 두면 AI 어드바이저가 규칙 기반 안내로만 답한다
GEMINI_API_KEY=

# 1이면 AI 어드바이저가 Gemini를 쓴다 (키가 있을 때)
VPD_ADVISOR_LLM=1

# 1이면 켤 때 "데모 온실 (farm3 재생)"을 만들고 지금 시각까지 이력을 채운다
VPD_DEMO=1

# 1이면 완전 읽기 전용: 가입·로그인 포함 모든 쓰기를 막고 질문하기만 열어 둔다
VPD_READONLY=0

# DB 주소. 비우면 backend/vpd.db (SQLite). 배포 때는 PostgreSQL 주소(postgresql://...)
# VPD_DATABASE_URL=
